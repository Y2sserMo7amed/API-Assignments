<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Adds Swagger so we get a nice page to test our endpoints in the browser -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <!--
      Required for "Add-Migration" / "dotnet ef migrations add" to work.
      The EF Tools need this Design package present in whichever project
      is set as the StartupProject (our API project), even though the
      actual DbContext lives in Infrastructure.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.28">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      The API project (Composition Root) is allowed to see Application AND Infrastructure.
      Controllers only ever talk to Application's interfaces - this Infrastructure
      reference exists purely so Program.cs can wire up the real implementations.
    -->
    <ProjectReference Include="..\ECommerceApp.Application\ECommerceApp.Application.csproj" />
    <ProjectReference Include="..\ECommerceApp.Infrastructure\ECommerceApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
